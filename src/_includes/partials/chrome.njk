{# The bar. Laid out on the same grid as .frame, so its rule lands exactly on
   the text column's edge at every width. #}
<header class="chrome">
  <div class="chrome-inner">
    <a class="site-name" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ site.title }}</a>
    <nav class="nav" aria-label="Sections">
      {%- for item in nav %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>
