<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and page.url != "/" %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
{% set desc = description or site.description %}
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml">

<meta property="og:type" content="{% if layout == 'essay.njk' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ desc }}">
<meta name="twitter:card" content="summary">
{% if site.twitter %}<meta name="twitter:site" content="@{{ site.twitter }}">{% endif %}

<link rel="stylesheet" href="/assets/css/tokens.css">
<link rel="stylesheet" href="/assets/css/site.css">

{# KaTeX renders at build time, so a math page needs its stylesheet and
   nothing else — no script, no CDN, and the fonts are vendored beside it. #}
{% if math %}
<link rel="stylesheet" href="/assets/katex/katex.min.css">
{% endif %}
